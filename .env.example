# ---------------------------------------------------------------------------
# Crypto Scanner Bot v2.2 — environment template
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#
# UPGRADING FROM v2.0 / v2.1: nothing is required. Every key added since v2.0
# (the risk-management block and REQUIRE_VOLUME_EXPANSION) has a working default,
# so an existing .env keeps running unchanged. Add them only to tune behaviour.
# Note that v2.2 is stricter by default: expect ~14% fewer signals than v2.1.
# ---------------------------------------------------------------------------

# --- Telegram (required unless DRY_RUN=true) -------------------------------
# Token issued by @BotFather, e.g. 123456789:AAF...
TELEGRAM_BOT_TOKEN=
# Numeric chat/channel id, e.g. 987654321 or -1001234567890 for a channel
TELEGRAM_CHAT_ID=

# --- Scanner settings ------------------------------------------------------
# Comma-separated watchlist in CCXT unified format
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Candle timeframe: 1m, 5m, 15m, 30m, 1h, 4h, 1d ...
TIMEFRAME=4h

# CCXT exchange id (public endpoints only — no API keys needed).
# Bybit is the default because Binance geo-blocks GitHub Actions runner IPs and
# answers with HTTP 451, so a scheduled workflow can never fetch candles from it.
# Bybit serves the same unified symbols, timeframes and base-asset volumes.
# 'binance' still works fine when running locally from an unblocked network.
EXCHANGE_ID=bybit

# Candles fetched per symbol. Must cover the SMA warm-up and the structural
# lookback, plus the still-forming candle that gets discarded — in practice at
# least SMA_PERIOD + 2. Venue maximum: 1000.
CANDLE_LIMIT=300

# --- Indicators ------------------------------------------------------------
# Trend filter: period of the close-price SMA. LONG requires close > this value,
# SHORT requires close < it.
SMA_PERIOD=200

# Volume filter: period of the volume SMA. Both directions require the signal
# candle's volume to exceed this average.
VOLUME_SMA_PERIOD=20

# Signal quality filter: minimum real body as a fraction of the candle's own
# high-low range, required of BOTH candles. Engulfing a one-tick doji body is
# mathematically valid but meaningless, and 0.05 discards those while keeping
# ~94% of patterns. Use 0.0 for the unfiltered definition; raise it (0.2-0.3)
# to demand decisive bars.
MIN_BODY_RATIO=0.05

# VSA follow-through: require the signal candle's volume to be strictly greater
# than the volume of the candle it engulfed. A bar can clear VOLUME_SMA_20 and
# still print LESS volume than the bar it swallowed — price reversed on fading
# participation, which is a move drifting rather than being driven. Measured on
# 4h data this removes ~14% of otherwise-valid signals.
# Set to false only to measure the rule's effect; the anomaly is real.
REQUIRE_VOLUME_EXPANSION=true

# --- Risk management -------------------------------------------------------
# Bars scanned for the structural extreme the stop anchors to, including the
# signal candle. A stop just under the signal candle sits inside the obvious
# pool of resting stops; anchoring to the recent swing places it beyond that
# pool. Wider stops mean smaller position sizes for the same account risk.
STRUCTURAL_LOOKBACK=10

# Buffer beyond the structural extreme, in PERCENT (0.1 = 0.1%). Keeps the stop
# off the exact tick where orders cluster.
STOP_BUFFER_PCT=0.1

# Reward-to-risk ladder, comma separated. "2,3" gives TP1 at 1:2 and TP2 at 1:3.
# Listed in ascending order in the alert regardless of the order written here.
RR_TARGETS=2,3

# --- Timing & resilience ---------------------------------------------------
# Grace period after a candle closes before scanning, so the venue has settled
POLL_BUFFER_SECONDS=10

# Extra pause between symbols, on top of CCXT's built-in rate limiter
REQUEST_DELAY_SECONDS=0.25

# Retries for transient network / rate-limit failures
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=15.0

# --- Logging ---------------------------------------------------------------
# DEBUG shows why each symbol was rejected — useful when tuning filters
LOG_LEVEL=INFO
# Optional rotating log file; leave blank for console-only output
LOG_FILE=

# --- Safety ----------------------------------------------------------------
# true = log alerts instead of sending them (no Telegram credentials required)
DRY_RUN=false
