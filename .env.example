# ---------------------------------------------------------------------------
# Crypto Scanner Bot v3.1 (Institutional MTF SMC) — environment template
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#
# UPGRADING FROM v3.0: nothing is required — every new key has a working
# default. But v3.1 is far stricter: expect roughly 1.7% of order blocks to
# reach the watchlist and about half of those to convert, versus v3.0 alerting
# on every validated block.
# ---------------------------------------------------------------------------

# --- Telegram (required unless DRY_RUN=true) -------------------------------
# Token issued by @BotFather, e.g. 123456789:AAF...
TELEGRAM_BOT_TOKEN=
# Numeric chat/channel id, e.g. 987654321 or -1001234567890 for a channel
TELEGRAM_CHAT_ID=

# --- Market data -----------------------------------------------------------
# Execution watchlist. Both spellings are accepted — BTCUSDT (Binance-native)
# and BTC/USDT (CCXT unified) resolve to the same pair.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT

# Higher timeframe — where structure is read and zones are defined.
TIMEFRAME=1h

# Lower timeframe — where entries are confirmed. Must be strictly faster than
# TIMEFRAME, or confirmation would just re-read the setup.
LTF_TIMEFRAME=15m

# CCXT exchange id (public endpoints only — no API keys needed).
#
# This MUST be the venue you execute on. v3.0 emits resting limit orders at
# exact order-block edges; Kraken and Binance disagree by up to 1.3% on thinner
# pairs, and against a stop that is often well under 1% a level taken from the
# wrong venue either fills instantly or never fills.
#
# Binance restricts GitHub Actions runner IPs, so a scheduled workflow cannot
# reach it — v3.0 needs a host Binance serves. Setting kraken here will run in
# CI, but treat the levels as indicative rather than executable.
EXCHANGE_ID=binance

# HTF candles per symbol. Three describe a structure, but premium/discount
# needs the full RANGE_LOOKBACK window behind it, so this must exceed it.
CANDLE_LIMIT=200

# LTF candles per symbol — only the recent confirmation window is examined.
LTF_CANDLE_LIMIT=120

# --- Structure detection ---------------------------------------------------
# Minimum real body as a fraction of a candle's own high-low range, required of
# both the order block and the impulse. A structure built on a doji says nothing
# about who was in control. Use 0.0 to disable.
MIN_BODY_RATIO=0.05

# Minimum fair value gap, as a PERCENT of price. A gap that exists but is only
# a few ticks wide is spread and noise, not institutional displacement. On 1h
# majors this rejects ~9% of blocks that have a gap at all.
MIN_FVG_PCT=0.30

# Candles forming the dealing range that premium/discount is measured against.
RANGE_LOOKBACK=50

# Only take blocks from the correct half of that range — discount for longs,
# premium for shorts. Set false to also take mid-range "decisional" blocks.
REQUIRE_EXTREME_OB=true

# Bars either side of a pivot needed to confirm it as a swing point. Used for
# the LTF change-of-character check.
SWING_STRENGTH=2

# LTF candles searched for a CHoCH + FVG sequence once a zone is tagged.
LTF_CONFIRM_WINDOW=30

# Minimum LTF gap, in percent. 0 accepts any genuine gap — the displacement
# filter that matters is applied on the HTF.
LTF_MIN_FVG_PCT=0.0

# Hours a watched zone stays live before it is retired as stale.
MAX_ZONE_AGE_HOURS=72

# --- Risk & execution ------------------------------------------------------
# Offset beyond the block's distal edge, in PERCENT (0.2 = 0.2%). Pushes the
# stop away from the zone so it is not sitting inside the pool of orders a
# liquidity sweep is aiming at.
STOP_BUFFER_PCT=0.2

# Widest stop, as a PERCENT of entry, that still counts as a tradable setup.
# Fixed-fraction sizing already holds the loss at RISK_PER_TRADE_PCT however
# wide the stop is, so this is not about account risk — it rejects order blocks
# so thick they have not located anything precise enough to trade, and which
# size down to a position too small to be worth the fees.
# Measured on 1h majors: 3.5 removes ~0.1% of blocks and about one signal a
# month. Set 0.0 to disable.
MAX_STOP_PCT=3.5

# Reward-to-risk multiple for the take-profit.
REWARD_RATIO=4

# Account equity in quote currency. Position size is derived from this, so a
# stale value silently mis-sizes every order.
ACCOUNT_EQUITY=10000

# Percent of equity risked per trade. Size = (equity * this%) / (entry - stop).
RISK_PER_TRADE_PCT=1

# --- Multi-timeframe state -------------------------------------------------
# Where watched zones are persisted. The zone lifecycle spans many candles but
# a scheduled run is a fresh process, so without this file no zone could ever
# reach confirmation. Contains no secrets; it is git-ignored anyway.
WATCHLIST_FILE=watchlist.json

# Concurrent market-data fetches. MTF doubles the request count and each one is
# almost entirely network wait, so threads overlap it (~3.4x faster measured).
MAX_WORKERS=4

# --- Timing & resilience ---------------------------------------------------
# Grace period after a candle closes before scanning, so the venue has settled
POLL_BUFFER_SECONDS=10

# Extra pause between symbols, on top of CCXT's built-in rate limiter
REQUEST_DELAY_SECONDS=0.25

# Retries for transient network / rate-limit failures
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=15.0

# --- Logging ---------------------------------------------------------------
# DEBUG shows why each symbol was rejected — useful when tuning
LOG_LEVEL=INFO
# Optional rotating log file; leave blank for console-only output
LOG_FILE=

# --- Safety ----------------------------------------------------------------
# true = log alerts instead of sending them (no Telegram credentials required)
DRY_RUN=false
